          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "korenan.ApiService"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "korenan.ApiService"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/image/bot/{room}": {
      "get": {
        "tags": [
          "korenan.ApiService"
        ],
        "parameters": [
          {
            "name": "room",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/wiki": {
      "get": {
        "tags": [
          "korenan.ApiService"
        ],
        "parameters": [
          {
            "name": "keyword",
